# ==============================================================================
# Ultimate Audio Studio - Environment Configuration Template
# ==============================================================================

# All app-specific variables use the UAS_ prefix so unrelated tools cannot change app behavior.
# Packaged builds (the .exe) ignore .env files entirely.

# Application Environment & Debugging
UAS_APP_ENV=production
UAS_DEBUG=false

# GitHub Releases & Auto-Update Configuration (Optional)
# GITHUB_UPDATE_TOKEN: Optional GitHub token (only needed if encountering GitHub API rate limits).
GITHUB_UPDATE_TOKEN=
UAS_GITHUB_OWNER=TheLastWallaby
UAS_GITHUB_REPO=Ultimate-Audio-Studio
UAS_RELEASES_API_URL=https://api.github.com/repos/TheLastWallaby/Ultimate-Audio-Studio/releases/latest

# Storage & Directory Paths (Optional Overrides)
# UAS_MUSIC_DIR=C:\Users\username\Music
# UAS_PLAYLISTS_PATH=
# UAS_SETTINGS_PATH=
# UAS_ERROR_LOG_PATH=
# UAS_YT_CACHE_DIR=
# UAS_COVER_CACHE_DIR=
# UAS_PREVIEW_CACHE_DIR=

# External Media Engine Binaries (Optional Overrides)
# UAS_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# UAS_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# SSL / CA Certificate Overrides
# SSL_CERT_FILE=
# REQUESTS_CA_BUNDLE=
