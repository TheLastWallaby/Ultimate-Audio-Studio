# ==============================================================================
# Ultimate Audio Studio - Environment Configuration Template
# ==============================================================================

# Application Environment & Debugging
APP_ENV=production
DEBUG=false

# GitHub Releases & Auto-Update Configuration
# GITHUB_UPDATE_TOKEN: Read-only Personal Access Token for private repository updates.
# If omitted or empty, the application falls back to audio_studio_settings.json or app/update_auth.py.
GITHUB_UPDATE_TOKEN=
GITHUB_OWNER=TheLastWallaby
GITHUB_REPO=Ultimate-Audio-Studio
RELEASES_API_URL=https://api.github.com/repos/TheLastWallaby/Ultimate-Audio-Studio/releases/latest

# Storage & Directory Paths (Optional Overrides)
# MUSIC_DIR=C:\Users\username\Music
# PLAYLISTS_PATH=
# SETTINGS_PATH=
# ERROR_LOG_PATH=
# YT_CACHE_DIR=
# COVER_CACHE_DIR=
# PREVIEW_CACHE_DIR=

# External Media Engine Binaries (Optional Overrides)
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# SSL / CA Certificate Overrides
# SSL_CERT_FILE=
# REQUESTS_CA_BUNDLE=
